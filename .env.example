# Discord Bot Token (Discord Developer Portal -> Applications -> [Botunuz] -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Logların gönderileceği #bot-logs kanalının ID'si (Panelden de seçilebilir; panel ayarı önceliklidir)
LOG_CHANNEL_ID=your_log_channel_id_here

# Web Yönetim Paneli
DASHBOARD_PORT=3000
# 127.0.0.1 = sadece bu bilgisayardan erişim. Dışarıya açmak için 0.0.0.0 yapın (şifre koymayı unutmayın!)
DASHBOARD_HOST=127.0.0.1
# Boş bırakılırsa şifre sorulmaz
DASHBOARD_PASSWORD=
