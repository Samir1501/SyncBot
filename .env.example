# Discord Bot Token (Discord Developer Portal -> Applications -> [Botunuz] -> Bot -> Reset Token)
DISCORD_TOKEN=your_bot_token_here

# Logların gönderileceği #bot-logs kanalının ID'si (Panelden de seçilebilir; panel ayarı önceliklidir)
LOG_CHANNEL_ID=your_log_channel_id_here

# Web Yönetim Paneli
DASHBOARD_PORT=3000
# 127.0.0.1 = sadece bu bilgisayardan erişim. Dışarıya açmak için 0.0.0.0 yapın (şifre koymayı unutmayın!)
DASHBOARD_HOST=127.0.0.1
# Boş bırakılırsa şifre sorulmaz
DASHBOARD_PASSWORD=

# --- RAM Optimizasyonu (opsiyonel) ---
# Kanal başına bellekte tutulan en fazla mesaj sayısı (varsayılan 100; discord.js varsayılanı 200).
# Silinen/düzenlenen mesaj loglarında içerik sadece önbellekteki mesajlar için gösterilebilir.
MESSAGE_CACHE_SIZE=100
# Bu süreden (saat) eski mesajlar önbellekten temizlenir (varsayılan 12). 0 = süre sınırı yok.
MESSAGE_CACHE_LIFETIME_HOURS=12
